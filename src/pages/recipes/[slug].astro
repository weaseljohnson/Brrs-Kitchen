---
import Layout from '../../layouts/Layout.astro';
import RecipeView from '../../components/RecipeView.astro';
import { buildRecipeSchema } from '../../utils/seo';
import { getPublishedRecipes } from '../../utils/recipes';

export const prerender = true;

export async function getStaticPaths() {
  const recipes = await getPublishedRecipes();
  return recipes.map(recipe => ({
    params: { slug: recipe.id.split('/').pop() },
    props:  { recipe },
  }));
}

const { recipe } = Astro.props;
const { slug }   = Astro.params;
const { title, intro, image } = recipe.data;
const recipeSchema = buildRecipeSchema(recipe.data, Astro.url.href, Astro.url.origin);
---

<Layout
  title={title}
  description={intro ?? ''}
  ogImage={image ?? '/images/og/og-default.jpg'}
  ogType="article"
  schema={[recipeSchema]}
>
  <RecipeView data={recipe.data} slug={slug!} />
</Layout>